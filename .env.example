# Copy this file to ".env" (same folder as main.py) and fill in the values.
# Never share the .env file with anyone.

# 1) AI provider: "gemini" = FREE (default).  "claude" = paid API.
LLM_PROVIDER=gemini

# Gemini free key  ->  https://aistudio.google.com/apikey  (no card needed)
GEMINI_API_KEY=AIzaxxxxxxxx
# If this model name stops working, pick a current Flash model in AI Studio
GEMINI_MODEL=gemini-2.5-flash

# (only if LLM_PROVIDER=claude)
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-5-5

# 2) Instagram (Instagram API with Instagram Login) - free
IG_USER_ID=1784xxxxxxxxxxxx
IG_ACCESS_TOKEN=IGAAxxxxxxxxxxxxxxxx
IG_HANDLE=@your_handle

# 3) Cloudinary free plan (Instagram needs a public image URL)
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_UPLOAD_PRESET=your_unsigned_preset

# 4) Post language: English / Marathi / Hinglish
POST_LANGUAGE=English

# 5) Only for Marathi: path to a Devanagari font (e.g. NotoSansDevanagari-Bold.ttf)
FONT_PATH=
